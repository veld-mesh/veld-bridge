# /etc/veld-bridge/wa.env
VB_SOCKET=/run/veld-bridge/wa.sock
VB_SESSION_DIR=/var/lib/veld-bridge/wa-session
VB_CHROMIUM=/usr/bin/chromium
VB_QR_PNG=/var/lib/veld-bridge/qr.png
# Voice notes are saved here briefly for core to transcribe (transcription.audio_dir).
VB_VOICE_DIR=/var/lib/veld-bridge/voice
VB_READY_TIMEOUT_MIN=5
PUPPETEER_SKIP_DOWNLOAD=1
# After the first successful link, pin WA Web to the cached version:
#   ls /var/lib/veld-bridge/wa-session/web-cache/   ->  2.3000.xxxxxxx.html
# WA_WEB_VERSION=2.3000.xxxxxxx
